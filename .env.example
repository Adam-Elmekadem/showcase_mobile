# Copy this file to .env and point it at your running Laravel API.
#
# - iOS Simulator on the same Mac as the API: http://127.0.0.1:8000/api
# - Android Emulator:                          http://10.0.2.2:8000/api
# - Physical phone (Expo Go) on the same Wi-Fi: http://<your-computer's-LAN-IP>:8000/api
#   Find your LAN IP with `ipconfig` (Windows) and make sure the API is served
#   with `php artisan serve --host=0.0.0.0` so it accepts LAN connections.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
